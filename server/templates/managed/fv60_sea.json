  "instructions": "taxItems：每一張統一發票一筆，通常有三家：樂爾幸泛通世（統一編號 28006223）、義佳（22368445）、貳零零（12762783）。每筆填 invoice（兩個英文字母加 8 位數字）、invDate（發票日期 YYYY-MM-DD，民國年換算西元，115 年 = 2026 年）、taxId（賣方統一編號 8 碼）、taxBase（銷售額／未稅金額，數字）、taxAmount（營業稅額，數字）。非發票的頁面（請款單、提單）不要產生 taxItems。billNo：義佳請款單號（例如 E1509008 或 YJ2607400）。caseNo：出口案號，JT 開頭加 7 位數字。osat：客戶代碼，例如 ATK、SCK、HANA、AMD蘇州。qty：出貨數量，找不到填 null。",
  "rules": [
    { "set": "id", "generate": "base36time" },
    { "set": "date", "today": true },
    { "set": "supplier", "value": "800000" },
    { "set": "supplierName", "value": "義佳有限公司" },
    {
      "set": "taxItems[].name",
      "lookup": "taxId",
      "table": { "28006223": "樂爾幸泛通世", "22368445": "義佳", "12762783": "貳零零" }
    },
    { "set": "isMultiItem", "value": true },
    { "set": "invoice", "join": "taxItems[].invoice", "separator": " / " },
    { "set": "expenseAmount", "sum": ["taxItems[].taxBase"] },
    { "set": "amount", "sum": ["taxItems[].taxBase", "taxItems[].taxAmount"] },
    { "set": "invDate", "copy": "date" },
    { "set": "price", "divide": ["amount", "qty"], "round": 3 },
    { "set": "text", "template": "出口/{osat}/{caseNo}" },
    { "set": "docNo", "value": "" },
    { "set": "done", "value": false }
  ]
