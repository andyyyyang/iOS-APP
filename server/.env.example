# 伺服器埠號（Railway 會自動注入 PORT）
PORT=3000

# API 金鑰，逗號分隔可放多把（必填；未設定時伺服器拒絕啟動，除非 NODE_ENV=test 或 ALLOW_NO_AUTH=1）
API_KEYS=change-me-1,change-me-2

# Postgres 連線字串（Railway 的 Postgres 服務會提供）。未設定時使用記憶體儲存（重啟即遺失，僅供開發）
# DATABASE_URL=postgres://user:password@localhost:5432/localocr

# Jev（TypeSafe AI）分類金鑰；亦接受 TYPESAFE_API_KEY。未設定時 /v1/classify 回傳 503
# JEV_API_KEY=
# JEV_MODEL=jev-latest

# 僅限本機開發：允許在沒有 API_KEYS 的情況下啟動（所有端點不需驗證）
# ALLOW_NO_AUTH=1

# Obsidian 筆記庫（Remotely Save 同步的 S3 相容儲存桶，例如 Railway Storage Bucket）。
# 四個都設定才啟用 /v1/vault 與 vault_* 工具；Railway 上用 ${{obsidian-vault.ENDPOINT}} 等變數參照
# VAULT_S3_ENDPOINT=https://t3.storageapi.dev
# VAULT_S3_BUCKET=obsidian-vault-xxxxxxxx
# VAULT_S3_ACCESS_KEY_ID=
# VAULT_S3_SECRET_ACCESS_KEY=
# VAULT_S3_REGION=auto
# VAULT_S3_FORCE_PATH_STYLE=false
# 與 Remotely Save 的 Remote prefix 相同；預設空白，有值時必須以 / 結尾
# VAULT_PREFIX=

# 伺服器的公開網址（配對連結 localocr://pair?server=… 與插件更新的 latest.json 使用）；未設定時取請求的網址
# PUBLIC_URL=https://xxx.up.railway.app

# 同步 Obsidian 插件版本（GitHub Releases → 儲存桶）時讀取 GitHub API 的權杖，只用來提高次數上限；不設定也可以
# GITHUB_TOKEN=
